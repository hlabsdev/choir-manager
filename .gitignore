# Configuration locale des outils
.claude/settings.local.json
.vscode/settings.json

# Fichiers temporaires de bureautique et de rendu
~$*.docx
docs/rendered/
docs/.rendered/

# Secrets et configuration d'environnement — jamais commités.
# Seul .env.example, qui ne contient que des valeurs factices, est suivi.
.env
.env.*
!.env.example
*.pem
*.key

# Sauvegardes et exports locaux (dumps PostgreSQL, archives de médias,
# copies de db.sqlite3 réalisées avant migration).
backups/
# Témoin écrit par `make prod-deploie` : chemin de la sauvegarde de repli.
# Local à l'hôte, jamais versionné — il ne veut rien dire ailleurs.
.dernier-pre-deploiement
*.dump
*.sql.gz
*.sqlite3.bak

# Volumes et données de conteneurs montés depuis l'hôte
.docker/
volumes/

# Imports opérationnels contenant des données personnelles réelles.
# ⚠️ Cette règle n'a AUCUN effet rétroactif : un fichier déjà suivi reste suivi
# (c'est le cas de docs/membres_hdgab.csv, cf. docs/AUDIT_SECURITE_V2.md).
docs/membres_*.csv
docs/membres_*.xlsx

# Fichiers système
.DS_Store
Thumbs.db
desktop.ini
