# ============================================================================
# ChoirManager — Variables d'environnement (modèle)
# ============================================================================
# Copier en `.env` puis remplacer TOUTES les valeurs `change-me` :
#     cp .env.example .env
#
# `.env` est ignoré par Git et ne doit jamais être commité. En production,
# utiliser le gestionnaire de secrets de la plateforme plutôt qu'un fichier.
#
# Générer une clé Django :
#     python -c "import secrets; print(secrets.token_urlsafe(64))"
#
# Rappel : depuis le jalon PostgreSQL/Docker, la configuration backend est
# FERMÉE par défaut dès que DJANGO_DEBUG=False. Une variable oubliée ci-dessous
# fait échouer le démarrage avec un message explicite — elle ne retombe jamais
# sur une valeur permissive.

# ─── PostgreSQL ─────────────────────────────────────────────────────────────
POSTGRES_DB=choirmanager
POSTGRES_USER=choirmanager
POSTGRES_PASSWORD=change-me

# compose.yaml construit DATABASE_URL à partir des trois variables POSTGRES_*
# ci-dessus. Ne pas recopier une URL contenant des ${...} dans .env : Compose
# ne développe pas récursivement les variables imbriquées.

# DJANGO_ALLOW_SQLITE n'a PAS sa place ici : ce fichier n'est lu que par Docker
# Compose, où DATABASE_URL est toujours fournie. Cette variable ne sert qu'au
# travail local hors Docker, et doit alors être EXPORTÉE DANS LE SHELL — rien
# ne charge de .env côté `manage.py` (os.environ brut, pas de dotenv).
# Cf. chm-backend/README.md § Démarrage rapide.

# ─── Cache (Redis) ──────────────────────────────────────────────────────────
# Ce n'est PAS un réglage de performance : le cache porte les compteurs de
# throttle. Sur le LocMemCache par défaut de Django, ils vivent dans chaque
# worker Gunicorn — chaque limite annoncée vaut alors jusqu'à
# GUNICORN_WORKERS fois sa valeur, de façon non déterministe.
# Absente hors DEBUG : démarrage refusé, jamais de repli silencieux.
REDIS_URL=redis://redis:6379/0

# Plafond mémoire du cache. Éviction LRU au-delà (cf. compose.yaml) : un Redis
# saturé doit continuer d'accepter des écritures, sinon les compteurs ne
# s'enregistrent plus et les throttles laissent tout passer.
REDIS_MAXMEMORY=128mb

# ─── Django ─────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ⛔ Nombre de proxys de confiance entre le client et Django. DÉCIDE DE LA
# VALIDITÉ DE TOUS LES PLAFONDS PAR IP.
#   trop haut → le client contrôle son identité : plafonds contournables ;
#   trop bas  → tous les clients partagent un compteur : blocage général.
# `1` = la topologie de compose.yaml (client → nginx frontend → backend).
# Toute autre topologie DOIT être mesurée sur l'hôte réel AVANT d'activer les
# throttles — procédure bloquante, cf. docs/DEPLOIEMENT.md §4.
DJANGO_NUM_PROXIES=1

# Redirection TLS : laissée au reverse-proxy public. Passer à True seulement si
# Django est exposé directement en HTTPS.
DJANGO_SECURE_SSL_REDIRECT=False
# Nécessaire si l'admin Django est servi derrière un domaine HTTPS,
# ex. https://chorale.example.org
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Cookies de session/CSRF marqués `Secure`.
#
# ⚠️ Les deux valeurs ci-dessous sont celles du POSTE DE DÉVELOPPEMENT, où la
# pile est servie en HTTP : un cookie `Secure` n'y serait jamais renvoyé par
# le navigateur (connexion à l'admin Django impossible, 403 CSRF). Elles ne
# doivent JAMAIS être recopiées telles quelles en production.
# `compose.prod.yaml` force désormais explicitement True/False côté backend,
# donc un `.env` de dev recopié sur le VPS ne peut plus dégrader la
# production. Pour un déploiement hors compose.prod.yaml, poser :
#     DJANGO_COOKIE_SECURE=True
#     DJANGO_ACCEPT_INSECURE_COOKIES=False
DJANGO_COOKIE_SECURE=False
# Dérogation OBLIGATOIRE et sans ambiguïté pour accepter des cookies non
# sécurisés hors DJANGO_DEBUG=True : sans cette variable, poser
# DJANGO_COOKIE_SECURE=False seul ne suffit plus, le démarrage échoue.
DJANGO_ACCEPT_INSECURE_COOKIES=True

# ─── CORS ───────────────────────────────────────────────────────────────────
# La cible de production est same-origin (Nginx sert le front ET relaie /api/),
# donc aucune origine tierce n'est nécessaire. Renseigner CORS_ALLOWED_ORIGINS
# uniquement si un client est servi depuis un autre domaine.
# CORS_ALLOW_ALL_ORIGINS=True est refusé quand DJANGO_DEBUG=False et que les
# credentials sont activés : cela autoriserait n'importe quel site à appeler
# l'API avec les identifiants du navigateur.
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=

# ─── Gunicorn ───────────────────────────────────────────────────────────────
# À régler selon la mémoire et le CPU de la cible, puis à mesurer.
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60

# ─── Publication du frontend ────────────────────────────────────────────────
# Seul port utilisateur de la pile.
#   127.0.0.1 → accessible depuis cette machine uniquement (DÉFAUT SÛR) ;
#   0.0.0.0   → accessible depuis le réseau local (tests sur mobile,
#               démonstration). La pile ne sert pas de TLS : à réserver à
#               un réseau de confiance, et à ne poser qu'explicitement.
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=8080

# ─── Email (notifications best-effort) ──────────────────────────────────────
# En développement, le backend console affiche les mails dans les logs.
# En production (Google Workspace) :
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#   EMAIL_HOST=smtp.gmail.com
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=

# ⚠️ SECRET RÉEL — mot de passe d'application Google, pas une valeur de dev
# comme le mot de passe PostgreSQL ci-dessus. Ne JAMAIS le committer, ni ici,
# ni dans un compose versionné. Il vit dans `.env` (ignoré par Git) ou, mieux,
# dans le gestionnaire de secrets de la plateforme d'hébergement.
EMAIL_HOST_PASSWORD=

EMAIL_USE_TLS=True

# Timeout SMTP, en secondes. L'envoi est SYNCHRONE dans la requête utilisateur :
# sans lui, un serveur qui accepte la connexion sans répondre bloque
# indéfiniment. 10 s couvre un serveur lent mais vivant sans approcher
# GUNICORN_TIMEOUT (60 s). Cf. chm-backend/chm_config/settings.py.
EMAIL_TIMEOUT=10

# Expéditeur affiché. Doit correspondre à un compte réellement autorisé à
# envoyer pour le domaine, sinon SPF/DKIM échouent (cf. docs/DEPLOIEMENT.md).
DEFAULT_FROM_EMAIL=ChoirManager <no-reply@example.invalid>

# Reply-To des emails SANS chorale rattachée (rejet d'une demande d'adhésion :
# la chorale n'a jamais été créée, aucun bureau à qui répondre). Les emails
# d'une chorale utilisent, eux, son propre `email_contact`.
# Vide → pas d'en-tête Reply-To, et le message le dit explicitement.
#
# C'est aussi l'adresse qui REÇOIT les alertes opérateur (nouvelle demande de
# chorale, nouvelle suggestion) — un seul et même carnet d'adresses pour
# « répondre à la plateforme » et « être notifié pour la plateforme ».
EMAIL_REPLY_TO_PLATEFORME=

# Origine publique de la pile, SANS slash final (ex. https://chorale.example.org).
# Sert à construire les liens absolus dans les emails : bouton de connexion
# pour un compte fraîchement créé, lien direct vers l'admin pour une alerte
# opérateur. Laissé vide, ces emails restent utilisables (identifiant/mot de
# passe toujours présents en texte) mais sans bouton cliquable.
SITE_URL=
# Durée de validité d'un lien de vérification d'email, en secondes (24 h).
EMAIL_VERIFICATION_TOKEN_MAX_AGE=86400
# Durée de validité d'un lien de réinitialisation self-service (secondes).
PASSWORD_RESET_TOKEN_MAX_AGE=1800

# ─── WhatsApp (passerelle WAHA) ─────────────────────────────────────────────
# Canal SORTANT, facultatif, pour les notifications transactionnelles
# (rappel de répétition, cotisation). Jamais pour une annonce générale : WAHA
# est une passerelle non officielle, et un usage trop agressif fait bannir le
# numéro connecté.
#
# DÉSACTIVÉ ici pour le développement (aucun échec de notification en local).
# ⚠️ `compose.prod.yaml` force WAHA_ENABLED=True par défaut : sur le serveur,
# WAHA_API_KEY est donc OBLIGATOIRE, sinon le démarrage est refusé. Pour
# déployer sans WhatsApp, poser explicitement WAHA_ENABLED=False.
WAHA_ENABLED=False
# URL INTERNE au réseau Compose. Ne jamais la mettre en dur dans une vue : le
# backend la lit via settings.WAHA_URL. Hors Docker (runserver seul), utiliser
# http://localhost:3000 et exposer le service par compose.dev.yaml.
WAHA_URL=http://waha:3000
# Nom de la session appairée une seule fois (cf. docs/DEPLOIEMENT.md).
WAHA_SESSION=chm-notifications
# Moteur WhatsApp : WEBJS (Chromium), NOWEB ou GOWS (protocole sans navigateur).
# Laisser WEBJS par défaut ; passer à NOWEB si WhatsApp déconnecte la session
# juste après le scan (le WEBJS peut être rejeté par WhatsApp Web).
WHATSAPP_DEFAULT_ENGINE=WEBJS
# Clé d'API WAHA. Vide en développement, OBLIGATOIRE en production quand le
# canal est actif : sans elle, le tableau de bord WAHA est ouvert à quiconque
# atteint le réseau Docker et peut lier un autre WhatsApp.
WAHA_API_KEY=
# Identifiants de l'interface web WAHA (racine du conteneur, en dev seulement).
# Laisser vides fait générer un mot de passe aléatoire à CHAQUE redémarrage,
# affiché une seule fois dans les logs du conteneur. Les fixer pour la locale.
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=
WHATSAPP_SWAGGER_USERNAME=admin
WHATSAPP_SWAGGER_PASSWORD=
# Plafond d'envois par chorale et par minute. Protège la session PARTAGÉE.
WAHA_MAX_PER_MINUTE=20
# Port HÔTE exposé par compose.dev.yaml pour joindre WAHA depuis la machine
# (curl, QR). Le port INTERNE reste 3000. Sous Windows, 3000 peut tomber dans
# une plage réservée par Hyper-V/WinNAT : choisir alors un port libre > 3114
# et le reporter dans .env. Sans objet en production (aucun port publié).
WAHA_HOST_PORT=3000
